    "Landing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hard": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Landing lag from a normal fall faster than softLandSpeed."
        },
        "softLandSpeed": { "type": "number", "format": "double" },
        "helpless": { "type": "integer", "format": "uint32", "minimum": 0 }
      },
      "required": ["hard", "softLandSpeed", "helpless"]
    },
    "Tech": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Press shield within this many frames before landing in tumble to tech."
        },
        "invuln": { "type": "integer", "format": "uint32", "minimum": 0 },
        "frames": { "type": "integer", "format": "uint32", "minimum": 0 }
      },
      "required": ["window", "invuln", "frames"]
    },
    "Knockdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minFrames": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Frames lying down before you can act."
        },
        "autoGetup": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Automatically stand up at this frame."
        },
        "getupFrames": { "type": "integer", "format": "uint32", "minimum": 0 },
        "getupInvuln": { "type": "integer", "format": "uint32", "minimum": 0 },
        "attackFrames": { "type": "integer", "format": "uint32", "minimum": 0 },
        "attackInvuln": { "type": "integer", "format": "uint32", "minimum": 0 },
        "attackActive": {
          "type": "array",
          "items": { "type": "integer", "format": "uint32", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2,
          "description": "Getup attack active frames (inclusive)."
        },
        "attack": {
          "type": "array",
          "items": { "$ref": "#/$defs/Hitbox" }
        }
      },
      "required": [
        "minFrames",
        "autoGetup",
        "getupFrames",
        "getupInvuln",
        "attackFrames",
        "attackInvuln",
        "attackActive",
        "attack"
      ]
    },
    "Hitbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "format": "uint32", "minimum": 0, "description": "First active phase frame." },
        "end": {
          "type": ["integer", "null"],
          "format": "uint32",
          "minimum": 0,
          "description": "Last active phase frame (inclusive). Omit to stay active until the phase ends."
        },
        "x": {
          "type": "number",
          "format": "double",
          "description": "Offset forward from the feet. Negative = behind."
        },
        "y": { "type": "number", "format": "double", "description": "Offset up from the feet." },
        "r": { "type": "number", "format": "double", "description": "Radius." },
        "damage": { "type": "number", "format": "double", "description": "Percent dealt." },
        "bkb": { "type": "number", "format": "double", "description": "Base knockback." },
        "kbg": {
          "type": "number",
          "format": "double",
          "description": "Knockback growth: knockback added per victim percent."
        },
        "angle": {
          "type": "number",
          "format": "double",
          "description": "Launch angle in degrees. 0 = forward, 90 = straight up, negative = down."
        },
        "dir": { "$ref": "#/$defs/LaunchDir" },
        "type": { "$ref": "#/$defs/HitType" },
        "setKb": {
          "type": "boolean",
          "description": "Fixed knockback: ignores the victim's percent (knockback = bkb × weight)."
        },
        "rehit": {
          "type": ["integer", "null"],
          "format": "uint32",
          "minimum": 0,
          "description": "Multi-hit: can hit the same victim again every this many frames (default: once per phase)."
        },
        "hitstunMult": {
          "type": "number",
          "format": "double",
          "description": "Multiplies the hitstun this box causes."
        },
        "hitstunAdd": { "type": "number", "format": "double", "description": "Flat frames added to hitstun." },
        "hitlagMult": {
          "type": "number",
          "format": "double",
          "description": "Multiplies hitlag (freeze frames) on hit."
        },
        "shieldDmgMult": { "type": "number", "format": "double", "description": "Multiplies shield damage." },
        "shieldStunMult": { "type": "number", "format": "double", "description": "Multiplies shield stun." },
        "counterDamage": {
          "type": "boolean",
          "description": "Counter strike: damage comes from the countered hit (see `Counter`). Inactive if nothing was countered."
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number", "format": "double" },
            "minItems": 4,
            "maxItems": 4
          },
          "description": "Per-frame position/size `[frame, x, y, r]`. A frame without an entry uses the closest earlier entry, or\nx/y/r before the first entry. Omit for a box that stays put."
        }
      },
      "required": ["x", "y", "r", "damage", "bkb", "kbg", "angle"],
      "description": "A hit circle. In a move phase, `start`/`end` are inclusive phase frames. For throws, projectiles and other\nhits that aren't frame-windowed they are ignored. When two boxes overlap a victim, the first listed wins."
    },
    "LaunchDir": {
      "oneOf": [
        { "type": "string", "const": "forward", "description": "The way the attacker faces." },
        { "type": "string", "const": "away", "description": "Away from the attacker's center (multi-direction hits)." },
        { "type": "string", "const": "back", "description": "Behind the attacker." }
      ],
      "description": "Launch direction rule."
    },
    "HitType": {
      "oneOf": [
        { "type": "string", "enum": ["normal"] },
        {
          "type": "string",
          "const": "spike",
          "description": "Always launches downward (a positive `angle` is mirrored below the horizon)."
        },
        {
          "type": "string",
          "const": "trip",
          "description": "Grounded victims are knocked prone instead of launched. Airborne victims are hit normally."
        },
        {
          "type": "string",
          "const": "sakurai",
          "description": "Angle chosen automatically: flat on weak grounded hits, higher on strong ones, 45° in the air (`global.hitTypes.sakurai`)."
        },
        {
          "type": "string",
          "const": "autolink",
          "description": "Pulls the victim toward the hitbox center, plus the attacker's momentum. For multi-hit moves (`rehit`)."
        },
        {
          "type": "string",
          "const": "windbox",
          "description": "No damage, hitstun or hitlag. Pushes anything it touches every frame along `angle` (strength = bkb)."
        },
        {
          "type": "string",
          "const": "electric",
          "description": "Longer victim hitlag (`global.hitTypes.electric`), with spark effects."
        },
        { "type": "string", "const": "grab", "description": "Grabs instead of hitting." }
      ],
      "description": "Hitbox behavior, modeled on Smash."
    },
