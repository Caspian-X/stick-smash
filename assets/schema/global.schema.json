        "dirAirDodgeSpeed": { "type": "number", "format": "double" },
        "dirAirDodgeDecay": { "type": "number", "format": "double" },
        "dirAirDodgeDecayFrames": { "type": "integer", "format": "uint32", "minimum": 0 },
        "dirAirDodgeLandingLag": { "type": "integer", "format": "uint32", "minimum": 0 }
