{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": ["string", "null"], "writeOnly": true },
    "schemaVersion": { "type": "integer", "format": "uint32", "minimum": 0 },
    "movement": { "$ref": "#/$defs/Movement" },
    "input": { "$ref": "#/$defs/InputRules" },
    "sim": { "$ref": "#/$defs/SimRules" },
    "ai": { "$ref": "#/$defs/AiRules" },
    "knockback": { "$ref": "#/$defs/Knockback" },
    "hitstun": { "$ref": "#/$defs/Hitstun" },
    "hitlag": { "$ref": "#/$defs/Hitlag" },
    "hitTypes": { "$ref": "#/$defs/HitTypes" },
    "shield": { "$ref": "#/$defs/Shield" },
    "dodge": { "$ref": "#/$defs/Dodge" },
    "landing": { "$ref": "#/$defs/Landing" },
    "tech": { "$ref": "#/$defs/Tech" },
    "knockdown": { "$ref": "#/$defs/Knockdown" },
    "ledge": { "$ref": "#/$defs/Ledge" },
    "grab": { "$ref": "#/$defs/Grab" },
    "respawn": { "$ref": "#/$defs/Respawn" },
    "match": { "$ref": "#/$defs/Match" },
    "palette": {
      "type": "array",
      "items": { "$ref": "#/$defs/PlayerColors" },
      "description": "Player colors by slot (8 slots)."
    }
  },
  "required": [
    "schemaVersion",
    "movement",
    "input",
    "sim",
    "ai",
    "knockback",
    "hitstun",
    "hitlag",
    "hitTypes",
    "shield",
    "dodge",
    "landing",
    "tech",
    "knockdown",
    "ledge",
    "grab",
    "respawn",
    "match",
    "palette"
  ],
  "title": "Global",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Movement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jumpsquat": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Frames crouching before takeoff. Jump still held on the last one = full hop, released = short hop."
        },
        "airDrag": {
          "type": "number",
          "format": "double",
          "description": "Air drift when no direction is held (multiplier per frame)."
        },
        "airDragHeld": {
          "type": "number",
          "format": "double",
          "description": "Air drift multiplier when a direction is held but already at max speed."
        },
        "fastFallMinVy": {
          "type": "number",
          "format": "double",
          "description": "Fast fall allowed once vertical speed is above this (negative = still slightly rising; y down)."
        },
        "fastFallKick": {
          "type": "number",
          "format": "double",
          "description": "Downward speed applied the frame you fast fall."
        },
        "attackAirAccel": {
          "type": "number",
          "format": "double",
          "description": "Air accel for moves with `air: \"attack\"`."
        },
        "aerialAccel": {
          "type": "number",
          "format": "double",
          "description": "Air accel for moves with `air: \"aerial\"`."
        },
        "helplessAccel": { "type": "number", "format": "double" },
        "upSpecialAccel": {
          "type": "number",
          "format": "double",
          "description": "Air accel for moves with `air: \"upSpecial\"`."
        },
        "attackFriction": {
          "type": "number",
          "format": "double",
          "description": "Ground friction multiplier during attacks; `slide` frames use attackSlideFriction."
        },
        "attackSlideFriction": { "type": "number", "format": "double" },
        "attackAirDrag": {
          "type": "number",
          "format": "double",
          "description": "Air drift multiplier during attacks when not accelerating."
        },
        "platformDrop": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Frames platforms are ignored after dropping through."
        },
        "pushRadius": {
          "type": "number",
          "format": "double",
          "description": "Fighters overlapping closer than this push apart."
        },
        "pushStrength": { "type": "number", "format": "double" },
        "dashAttackSpeed": {
          "type": "number",
          "format": "double",
          "description": "Ground speed needed for attack → dash attack and grab → dash grab."
        },
        "dashGrabSpeed": { "type": "number", "format": "double" },
        "tapWindow": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Frames a direction press counts as a \"tap\" for smash attacks, rolls and spot dodges."
        },
        "bReverseWindow": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Frames after a `bReverse` move starts in which pressing the other direction turns it around."
        }
      },
      "required": [
        "jumpsquat",
        "airDrag",
        "airDragHeld",
        "fastFallMinVy",
        "fastFallKick",
        "attackAirAccel",
        "aerialAccel",
        "helplessAccel",
        "upSpecialAccel",
        "attackFriction",
        "attackSlideFriction",
        "attackAirDrag",
        "platformDrop",
        "pushRadius",
        "pushStrength",
        "dashAttackSpeed",
        "dashGrabSpeed",
        "tapWindow",
        "bReverseWindow"
      ],
      "description": "Shared movement rules. Per-fighter speeds and gravity live in each fighter's `stats`."
    },
    "InputRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stickThreshold": { "type": "integer", "format": "int8", "minimum": -128, "maximum": 127 },
        "bufferFrames": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Human press buffer lifetime in ticks (inclusive); 0 disables re-delivery."
        }
      },
      "required": ["stickThreshold", "bufferFrames"],
      "description": "Digital stick interpretation; history is part of the rollback snapshot."
    },
    "SimRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jumpsquatFriction": { "type": "number", "format": "double" },
        "landingFriction": { "type": "number", "format": "double" },
        "shieldFriction": { "type": "number", "format": "double" },
        "dodgeFriction": { "type": "number", "format": "double" },
        "shieldbreakFriction": { "type": "number", "format": "double" },
        "knockdownFriction": { "type": "number", "format": "double" },
        "pushHeight": { "type": "number", "format": "double" },
        "mainPad": { "type": "number", "format": "double" },
        "platformPad": { "type": "number", "format": "double" },
        "surfaceTolerance": { "type": "number", "format": "double" },
        "techMinSpeed": {
          "type": "number",
          "format": "double",
          "description": "Minimum downward landing speed to tech or enter knockdown from tumble."
        },
        "hitstunParticleSpeed": {
          "type": "number",
          "format": "double",
          "description": "Speed above which hitstun emits alternate-frame trail particles."
        },
        "knockdownDrag": { "type": "number", "format": "double" },
        "flipFrames": { "type": "integer", "format": "uint32", "minimum": 0 },
        "ledgeDropSpeed": { "type": "number", "format": "double" },
        "ledgeDropOffset": { "type": "number", "format": "double" },
        "ledgePullIn": { "type": "number", "format": "double" },
        "ledgeJumpOffset": { "type": "number", "format": "double" },
        "ledgeJumpDrift": { "type": "number", "format": "double" },
        "ledgeJumpCooldown": { "type": "integer", "format": "uint32", "minimum": 0 },
        "grabOffset": { "type": "number", "format": "double" },
        "releaseVx": { "type": "number", "format": "double" },
        "releaseVy": { "type": "number", "format": "double" },
        "escapeAttackerVx": { "type": "number", "format": "double" },
        "escapeVx": { "type": "number", "format": "double" },
        "escapeVy": { "type": "number", "format": "double" },
        "throwForward": { "type": "number", "format": "double" },
        "throwBackHeight": { "type": "number", "format": "double" },
        "throwUpHeight": { "type": "number", "format": "double" },
        "throwDownOffset": { "type": "number", "format": "double" },
        "platformDropOffset": { "type": "number", "format": "double" },
        "maxDamage": { "type": "number", "format": "double" },
        "projectilePad": { "type": "number", "format": "double" },
        "projectileWallTop": { "type": "number", "format": "double" }
      },
      "required": [
        "jumpsquatFriction",
        "landingFriction",
        "shieldFriction",
        "dodgeFriction",
        "shieldbreakFriction",
        "knockdownFriction",
        "pushHeight",
        "mainPad",
        "platformPad",
        "surfaceTolerance",
        "techMinSpeed",
        "hitstunParticleSpeed",
        "knockdownDrag",
        "flipFrames",
        "ledgeDropSpeed",
        "ledgeDropOffset",
        "ledgePullIn",
        "ledgeJumpOffset",
        "ledgeJumpDrift",
        "ledgeJumpCooldown",
        "grabOffset",
        "releaseVx",
        "releaseVy",
        "escapeAttackerVx",
        "escapeVx",
        "escapeVy",
        "throwForward",
        "throwBackHeight",
        "throwUpHeight",
        "throwDownOffset",
        "platformDropOffset",
        "maxDamage",
        "projectilePad",
        "projectileWallTop"
      ],
      "description": "Shared simulation constants retained from the reference implementation."
    },
    "AiRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialCool": { "type": "number", "format": "double" },
        "react": {
          "type": "array",
          "items": { "type": "number", "format": "double" },
          "minItems": 3,
          "maxItems": 3
        },
        "aggression": {
          "type": "array",
          "items": { "type": "number", "format": "double" },
          "minItems": 3,
          "maxItems": 3
        },
        "mash": {
          "type": "array",
          "items": { "type": "number", "format": "double" },
          "minItems": 3,
          "maxItems": 3
        },
        "tech": {
          "type": "array",
          "items": { "type": "number", "format": "double" },
          "minItems": 3,
          "maxItems": 3
        },
        "shieldResponse": {
          "type": "array",
          "items": { "type": "number", "format": "double" },
          "minItems": 3,
          "maxItems": 3
        },
        "defend": {
          "type": "array",
          "items": { "type": "number", "format": "double" },
          "minItems": 3,
          "maxItems": 3
        },
        "projectileDefend": {
          "type": "array",
          "items": { "type": "number", "format": "double" },
          "minItems": 3,
          "maxItems": 3
        },
        "charge": {
          "type": "array",
          "items": { "type": "number", "format": "double" },
          "minItems": 3,
          "maxItems": 3
        },
        "thresholds": {
          "$ref": "#/$defs/AiThresholds",
          "description": "Named thresholds for the fixed, shared decision tree (not fighter/move identities)."
        }
      },
      "required": [
        "initialCool",
        "react",
        "aggression",
        "mash",
        "tech",
        "shieldResponse",
        "defend",
        "projectileDefend",
        "charge",
        "thresholds"
      ],
      "description": "CPU decision thresholds in reference branch order. Arrays are indexed by difficulty (0..2)."
    },
    "AiThresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recoveryHeight": { "type": "number", "format": "double" },
        "recoveryEdge": { "type": "number", "format": "double" },
        "centerChance": { "type": "number", "format": "double" },
        "knockdownWait": { "type": "number", "format": "double" },
        "knockdownRandom": { "type": "number", "format": "double" },
        "knockdownAttack": { "type": "number", "format": "double" },
        "knockdownCenter": { "type": "number", "format": "double" },
        "ledgeWaitMin": { "type": "number", "format": "double" },
        "ledgeWaitMax": { "type": "number", "format": "double" },
        "ledgeJump": { "type": "number", "format": "double" },
        "ledgeAttack": { "type": "number", "format": "double" },
        "ledgeShield": { "type": "number", "format": "double" },
        "holdMin": { "type": "number", "format": "double" },
        "holdMax": { "type": "number", "format": "double" },
        "pummelMax": { "type": "number", "format": "double" },
        "pummelChance": { "type": "number", "format": "double" },
        "throwKillPercent": { "type": "number", "format": "double" },
        "throwDown": { "type": "number", "format": "double" },
        "throwUp": { "type": "number", "format": "double" },
        "throwForward": { "type": "number", "format": "double" },
        "shieldClose": { "type": "number", "format": "double" },
        "shieldGrab": { "type": "number", "format": "double" },
        "shieldSpecial": { "type": "number", "format": "double" },
        "jumpHold": { "type": "number", "format": "double" },
        "shieldMin": { "type": "number", "format": "double" },
        "underPad": { "type": "number", "format": "double" },
        "underBottom": { "type": "number", "format": "double" },
        "offstagePad": { "type": "number", "format": "double" },
        "recoverJumpVy": { "type": "number", "format": "double" },
        "recoverJumpHeight": { "type": "number", "format": "double" },
        "recoverSpecialVy": { "type": "number", "format": "double" },
        "recoverSpecialHeight": { "type": "number", "format": "double" },
        "recoverSpecialDistance": { "type": "number", "format": "double" },
        "recoverSpecialDepth": { "type": "number", "format": "double" },
        "centerDeadzone": { "type": "number", "format": "double" },
        "targetPad": { "type": "number", "format": "double" },
        "targetDeadzone": { "type": "number", "format": "double" },
        "defendDistance": { "type": "number", "format": "double" },
        "defendHeight": { "type": "number", "format": "double" },
        "shieldHoldMin": { "type": "number", "format": "double" },
        "shieldHoldMax": { "type": "number", "format": "double" },
        "projectileDistance": { "type": "number", "format": "double" },
        "projectileHeight": { "type": "number", "format": "double" },
        "projectileShieldChance": { "type": "number", "format": "double" },
        "projectileShieldFrames": { "type": "number", "format": "double" },
        "jumpTargetHeight": { "type": "number", "format": "double" },
        "jumpTargetDistance": { "type": "number", "format": "double" },
        "jumpChance": { "type": "number", "format": "double" },
        "dropHeight": { "type": "number", "format": "double" },
        "dropDistance": { "type": "number", "format": "double" },
        "dropChance": { "type": "number", "format": "double" },
        "attackHeight": { "type": "number", "format": "double" },
        "punishDizzyCharge": { "type": "number", "format": "double" },
        "punishCharge": { "type": "number", "format": "double" },
        "smashChance": { "type": "number", "format": "double" },
        "smashForward": { "type": "number", "format": "double" },
        "smashDown": { "type": "number", "format": "double" },
        "grabChance": { "type": "number", "format": "double" },
        "tiltChance": { "type": "number", "format": "double" },
        "downTiltChance": { "type": "number", "format": "double" },
        "jabChance": { "type": "number", "format": "double" },
        "upAttackHeight": { "type": "number", "format": "double" },
        "upAttackDistance": { "type": "number", "format": "double" },
        "downAttackHeight": { "type": "number", "format": "double" },
        "downAttackDistance": { "type": "number", "format": "double" },
        "projectileTargetHeight": { "type": "number", "format": "double" }
      },
      "required": [
        "recoveryHeight",
        "recoveryEdge",
        "centerChance",
        "knockdownWait",
        "knockdownRandom",
        "knockdownAttack",
        "knockdownCenter",
        "ledgeWaitMin",
        "ledgeWaitMax",
        "ledgeJump",
        "ledgeAttack",
        "ledgeShield",
        "holdMin",
        "holdMax",
        "pummelMax",
        "pummelChance",
        "throwKillPercent",
        "throwDown",
        "throwUp",
        "throwForward",
        "shieldClose",
        "shieldGrab",
        "shieldSpecial",
        "jumpHold",
        "shieldMin",
        "underPad",
        "underBottom",
        "offstagePad",
        "recoverJumpVy",
        "recoverJumpHeight",
        "recoverSpecialVy",
        "recoverSpecialHeight",
        "recoverSpecialDistance",
        "recoverSpecialDepth",
        "centerDeadzone",
        "targetPad",
        "targetDeadzone",
        "defendDistance",
        "defendHeight",
        "shieldHoldMin",
        "shieldHoldMax",
        "projectileDistance",
        "projectileHeight",
        "projectileShieldChance",
        "projectileShieldFrames",
        "jumpTargetHeight",
        "jumpTargetDistance",
        "jumpChance",
        "dropHeight",
        "dropDistance",
        "dropChance",
        "attackHeight",
        "punishDizzyCharge",
        "punishCharge",
        "smashChance",
        "smashForward",
        "smashDown",
        "grabChance",
        "tiltChance",
        "downTiltChance",
        "jabChance",
        "upAttackHeight",
        "upAttackDistance",
        "downAttackHeight",
        "downAttackDistance",
        "projectileTargetHeight"
      ],
      "description": "Geometry, timing, and probability thresholds for the shared CPU decision tree."
    },
    "Knockback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kbPercentScale": { "type": "number", "format": "double" },
        "tumbleThreshold": {
          "type": "number",
          "format": "double",
          "description": "Knockback above this sends the victim tumbling (can tech, lands in knockdown)."
        },
        "groundBounce": {
          "type": "number",
          "format": "double",
          "description": "Hitting a grounded victim downward bounces them up at this fraction."
        },
        "chargeDamageDivisor": {
          "type": "number",
          "format": "double",
          "description": "Charge: damage × (1 + charge / chargeDamageDivisor)."
        },
        "chargeKbRatio": {
          "type": "number",
          "format": "double",
          "description": "Fraction of the charge damage bonus that also applies to base knockback."
        }
      },
      "required": ["kbPercentScale", "tumbleThreshold", "groundBounce", "chargeDamageDivisor", "chargeKbRatio"],
      "description": "Knockback = (bkb + victimPercent × kbg × kbPercentScale) × victimWeight."
    },
    "Hitstun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "perKnockback": { "type": "number", "format": "double" },
        "base": { "type": "number", "format": "double" },
        "gravity": { "type": "number", "format": "double" },
        "maxFall": { "type": "number", "format": "double" },
        "airDrag": { "type": "number", "format": "double" },
        "groundDrag": { "type": "number", "format": "double" },
        "driftAccel": {
          "type": "number",
          "format": "double",
          "description": "Horizontal drift you can add while in hitstun (per frame)."
        }
      },
      "required": ["perKnockback", "base", "gravity", "maxFall", "airDrag", "groundDrag", "driftAccel"],
      "description": "Hitstun = floor(knockback × perKnockback) + base, then per-hitbox hitstunMult/hitstunAdd."
    },
    "Hitlag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": { "type": "number", "format": "double" },
        "perDamage": { "type": "number", "format": "double" },
        "perKnockback": { "type": "number", "format": "double" },
        "max": { "type": "number", "format": "double" }
      },
      "required": ["base", "perDamage", "perKnockback", "max"],
      "description": "Hitlag (freeze frames for both fighters) = min(max, floor(base + damage × perDamage + knockback × perKnockback))."
    },
    "HitTypes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trip": { "$ref": "#/$defs/TripRule" },
        "sakurai": { "$ref": "#/$defs/SakuraiRule" },
        "autolink": { "$ref": "#/$defs/AutolinkRule" },
        "windbox": { "$ref": "#/$defs/WindboxRule" },
        "electric": { "$ref": "#/$defs/ElectricRule" }
      },
      "required": ["trip", "sakurai", "autolink", "windbox", "electric"],
      "description": "Rules for each hitbox `type`."
    },
    "TripRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slide": { "type": "number", "format": "double" }
      },
      "required": ["slide"],
      "description": "Grounded victim knocked prone: slide speed away from the attacker."
    },
    "SakuraiRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groundLow": { "type": "number", "format": "double" },
        "groundHigh": { "type": "number", "format": "double" },
        "air": { "type": "number", "format": "double" }
      },
      "required": ["groundLow", "groundHigh", "air"],
      "description": "Auto angle: grounded hits below tumble knockback use groundLow, stronger grounded hits groundHigh, airborne hits air."
    },
    "AutolinkRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pull": { "type": "number", "format": "double" },
        "momentum": { "type": "number", "format": "double" }
      },
      "required": ["pull", "momentum"],
      "description": "Victim velocity = (hitbox center − victim center) × pull + attacker velocity × momentum."
    },
    "WindboxRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "push": { "type": "number", "format": "double" },
        "maxSpeed": { "type": "number", "format": "double" }
      },
      "required": ["push", "maxSpeed"],
      "description": "Push per frame = bkb × push × victim weight, capped at maxSpeed."
    },
    "ElectricRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "victimHitlagMult": { "type": "number", "format": "double", "description": "Victim hitlag multiplier." }
      },
      "required": ["victimHitlagMult"]
    },
    "Shield": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max": { "type": "number", "format": "double" },
        "decay": { "type": "number", "format": "double", "description": "Shield HP lost per frame while held." },
        "regen": {
          "type": "number",
          "format": "double",
          "description": "Shield HP regained per frame while not shielding."
        },
        "damageMult": {
          "type": "number",
          "format": "double",
          "description": "Shield HP lost = damage × damageMult × hitbox.shieldDmgMult."
        },
        "stunPerDamage": {
          "type": "number",
          "format": "double",
          "description": "Shield stun = floor(damage × stunPerDamage + stunBase)."
        },
        "stunBase": { "type": "number", "format": "double" },
        "hitlagBase": {
          "type": "number",
          "format": "double",
          "description": "Shield hitlag = floor(hitlagBase + damage × hitlagPerDamage)."
        },
        "hitlagPerDamage": { "type": "number", "format": "double" },
        "pushPerDamage": {
          "type": "number",
          "format": "double",
          "description": "Defender slide = damage × pushPerDamage + pushBase."
        },
        "pushBase": { "type": "number", "format": "double" },
        "attackerPushback": {
          "type": "number",
          "format": "double",
          "description": "Attacker's own pushback on a shielded grounded hit."
        },
        "dropLag": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Frames of lag after releasing shield."
        },
        "breakLaunch": { "type": "number", "format": "double" },
        "breakGravity": { "type": "number", "format": "double" },
        "breakMaxFall": { "type": "number", "format": "double" },
        "dizzyBase": {
          "type": "number",
          "format": "double",
          "description": "Dizzy duration = max(dizzyMin, dizzyBase − percent × dizzyPerPercent)."
        },
        "dizzyMin": { "type": "number", "format": "double" },
        "dizzyPerPercent": { "type": "number", "format": "double" },
        "dizzyMash": {
          "type": "number",
          "format": "double",
          "description": "Frames removed from dizzy per button press."
        },
        "dizzyRecoverHP": {
          "type": "number",
          "format": "double",
          "description": "Shield HP after recovering from dizzy."
        }
      },
      "required": [
        "max",
        "decay",
        "regen",
        "damageMult",
        "stunPerDamage",
        "stunBase",
        "hitlagBase",
        "hitlagPerDamage",
        "pushPerDamage",
        "pushBase",
        "attackerPushback",
        "dropLag",
        "breakLaunch",
        "breakGravity",
        "breakMaxFall",
        "dizzyBase",
        "dizzyMin",
        "dizzyPerPercent",
        "dizzyMash",
        "dizzyRecoverHP"
      ]
    },
    "Dodge": {
