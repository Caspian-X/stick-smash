{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": ["string", "null"], "writeOnly": true },
    "schemaVersion": { "type": "integer", "format": "uint32", "minimum": 0, "x-unit": "none" },
    "name": { "type": "string" },
    "width": {
      "type": "number",
      "format": "double",
      "description": "Default view size; the camera starts framing `[0, width] × [0, height]`.",
      "x-unit": "px",
      "x-axis": "x"
    },
    "height": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/Ground" },
      "description": "Static solids in collision tie-break order. At least one is required. Bounds including\nundersides must not overlap; touching blocks can form walls or a raised centre."
    },
    "platforms": {
      "type": "array",
      "items": { "$ref": "#/$defs/Platform" },
      "description": "Pass-through platforms.",
      "default": []
    },
    "ledge": { "$ref": "#/$defs/LedgeZone" },
    "blast": { "$ref": "#/$defs/Bounds", "description": "Fighters past these lines are KO'd." },
    "camera": { "$ref": "#/$defs/Bounds", "description": "The camera never shows past these." },
    "zoom": {
      "anyOf": [
        { "$ref": "#/$defs/Zoom" },
        { "type": "null" }
      ],
      "description": "Presentation-only visible-height limits in stage pixels. Each absent bound uses the automatic\ngeometry-derived range; camera bounds still cap the view. Values must be positive, minHeight ≤ maxHeight."
    },
    "spawns": {
      "type": "array",
      "items": { "$ref": "#/$defs/Spawn" },
      "description": "Start positions by player slot. Needs one per player (8 for a full match)."
    },
    "respawns": {
      "type": "array",
      "items": { "$ref": "#/$defs/RespawnPoint" },
      "description": "Respawn points by player slot."
    },
    "art": { "$ref": "#/$defs/StageArt" }
  },
  "required": [
    "schemaVersion",
    "name",
    "width",
    "height",
    "blocks",
    "ledge",
    "blast",
    "camera",
    "spawns",
    "respawns",
    "art"
  ],
  "title": "Stage",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Ground": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "right": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "top": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "bottom": {
          "type": "number",
          "format": "double",
          "description": "Bottom of the vertical walls.",
          "x-unit": "px",
          "x-axis": "y"
        },
        "underDepth": {
          "type": "number",
          "format": "double",
          "description": "Underside below `bottom`: slopes `depth` down while moving `inset` inward, so rising fighters slide out to\nthe wall.",
          "x-unit": "px",
          "x-axis": "y"
        },
        "underInset": {
          "type": "number",
          "format": "double",
          "description": "Positive taper width on each side; cannot exceed half the block width.",
          "x-unit": "px",
          "x-axis": "x"
        },
        "leftLedge": { "type": "boolean", "description": "Whether the top-left corner can be grabbed." },
        "rightLedge": { "type": "boolean", "description": "Whether the top-right corner can be grabbed." }
      },
      "required": ["left", "right", "top", "bottom", "underDepth", "underInset", "leftLedge", "rightLedge"],
      "description": "Solid rectangle with a tapered underside. Only the two top corners can be ledges."
    },
    "Platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x1": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "x2": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "y": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "motion": {
          "anyOf": [
            { "$ref": "#/$defs/Motion" },
            { "type": "null" }
          ],
          "description": "Translation relative to x1/x2/y; absent means stationary."
        }
      },
      "required": ["x1", "x2", "y"]
    },
    "Motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "waypoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/Waypoint" },
          "description": "At least two offsets. Leg j to j+1 uses waypoint j's travelTicks in both directions.\nIn loop mode the last duration closes the loop; in pingPong it is ignored. Waits occur before departure."
        },
        "mode": { "$ref": "#/$defs/PathMode" },
        "phase": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "Advance this many ticks into the repeating cycle at world frame zero.",
          "default": 0,
          "x-unit": "tick"
        }
      },
      "required": ["waypoints", "mode"],
      "description": "Deterministic translation sampled at the world frame. Travel is linear; no velocity state is stored."
    },
    "Waypoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "format": "double",
          "description": "Horizontal translation from the platform's base coordinates.",
          "x-unit": "px",
          "x-axis": "x"
        },
        "y": {
          "type": "number",
          "format": "double",
          "description": "Vertical translation from the platform's base height (positive is down).",
          "x-unit": "px",
          "x-axis": "y"
        },
        "travelTicks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Travel ticks to the next waypoint, also used on the return leg. Ignored at the last pingPong waypoint.",
          "x-unit": "tick"
        },
        "waitTicks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Ticks spent at this waypoint before departing; defaults to zero.",
          "default": 0,
          "x-unit": "tick"
        }
      },
      "required": ["x", "y", "travelTicks"]
    },
    "PathMode": {
      "oneOf": [
        { "type": "string", "const": "loop", "description": "Last waypoint travels back to the first." },
        {
          "type": "string",
          "const": "pingPong",
          "description": "Reverse at each endpoint, without duplicating endpoint waits."
        }
      ]
    },
    "LedgeZone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "r": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "xy" },
        "cy": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "handY": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "reachIn": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "hangX": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "hangY": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" }
      },
      "required": ["r", "cy", "handY", "reachIn", "hangX", "hangY"],
      "description": "Ledge grab zone: a half circle on the outside of each enabled block corner, centered `cy` below it. A falling\nfighter grabs when their hand point (`handY` above the feet) is inside. `reachIn` lets the flat side extend a\nfew pixels over the stage. `hangX`/`hangY` = where the feet sit while hanging."
    },
    "Bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "right": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "top": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "bottom": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" }
      },
      "required": ["left", "right", "top", "bottom"]
    },
    "Zoom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minHeight": {
          "type": ["number", "null"],
          "format": "double",
          "description": "Closest visible height in stage pixels; absent uses the automatic stage-size scaling.",
          "x-unit": "px",
          "x-axis": "y"
        },
        "maxHeight": {
          "type": ["number", "null"],
          "format": "double",
          "description": "Widest visible height in stage pixels; absent fits the stage geometry automatically.",
          "x-unit": "px",
          "x-axis": "y"
        }
      },
      "description": "Optional follow-camera zoom overrides; omitted bounds are automatic."
    },
    "Spawn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "y": {
          "type": ["number", "null"],
          "format": "double",
          "description": "Feet height; omit to stand on the highest block below x.",
          "x-unit": "px",
          "x-axis": "y"
        },
        "face": {
          "type": "integer",
          "format": "int8",
          "minimum": -128,
          "maximum": 127,
          "description": "1 = facing right, -1 = left.",
          "x-unit": "none"
        }
      },
      "required": ["x", "face"]
    },
    "RespawnPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "startY": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "endY": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" }
      },
      "required": ["x", "startY", "endY"],
      "description": "Respawn: descend from `startY` to `endY` above `x`, then wait on the respawn platform."
    },
    "StageArt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groundTop": { "$ref": "#/$defs/Color", "description": "Ground face gradient, top to bottom." },
        "groundBottom": { "$ref": "#/$defs/Color" },
        "underside": { "$ref": "#/$defs/Color" },
        "edge": { "$ref": "#/$defs/Color", "description": "Bright strip along the ground's top edge." },
        "platform": { "$ref": "#/$defs/Color" },
        "platformShadow": { "$ref": "#/$defs/Color", "description": "Soft band under each platform." },
        "edgeWidth": {
          "type": "number",
          "format": "double",
          "description": "Height of the `edge` strip.",
          "x-unit": "px",
          "x-axis": "y"
        },
        "platformThickness": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "platformRadius": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "xy" },
        "platformShadowBand": {
          "type": "array",
          "items": { "type": "number", "format": "double" },
          "minItems": 3,
          "maxItems": 3,
          "description": "Shadow band: starts `[offset]` below the platform top, `[height]` tall, at `[alpha]` opacity.",
          "x-unit": ["px", "px", "ratio"],
          "x-axis": ["y", "y", null]
        },
        "stripes": {
          "anyOf": [
            { "$ref": "#/$defs/Stripes" },
            { "type": "null" }
          ],
          "description": "Dashes along the ground face."
        },
        "background": {
          "anyOf": [
            { "$ref": "#/$defs/Background" },
            { "type": "null" }
          ],
          "description": "Procedural backdrop, filling the `camera` bounds."
        }
      },
      "required": [
        "groundTop",
        "groundBottom",
        "underside",
        "edge",
        "platform",
        "platformShadow",
        "edgeWidth",
        "platformThickness",
        "platformRadius",
        "platformShadowBand"
      ]
    },
    "Color": {
      "description": "\"#rrggbb\", or a player palette slot: \"player\", \"playerDark\", \"playerLight\".",
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}|player|playerDark|playerLight)$"
    },
    "Stripes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "y": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "w": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "h": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "every": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "color": { "$ref": "#/$defs/Color" },
        "alpha": { "type": "number", "format": "double", "x-unit": "ratio" }
      },
      "required": ["x", "y", "w", "h", "every", "color", "alpha"],
      "description": "Dashes `w`×`h` every `every` px, `y` below the ground top, starting `x` from the left edge."
    },
    "Background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sky": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "format": "double" },
              { "$ref": "#/$defs/Color" }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Vertical gradient `[y, color]` stops, top to bottom. Solid above the first and below the last.",
          "x-unit": "px",
          "x-axis": "y"
        },
        "moon": {
          "anyOf": [
            { "$ref": "#/$defs/Moon" },
            { "type": "null" }
          ]
        },
        "ridges": {
          "type": "array",
          "items": { "$ref": "#/$defs/Ridge" },
          "description": "Hill silhouettes, back to front."
        },
        "stars": {
          "anyOf": [
            { "$ref": "#/$defs/Starfield" },
            { "type": "null" }
          ]
        },
        "parallax": {
          "type": "number",
          "format": "double",
          "description": "0..1: how much the backdrop stays put on screen while the camera moves (0 = moves with the stage).",
          "default": 0.0,
          "x-unit": "ratio"
        }
      },
      "required": ["sky"]
    },
    "Moon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "y": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "r": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "xy" },
        "color": { "$ref": "#/$defs/Color" },
        "glow": {
          "$ref": "#/$defs/Color",
          "description": "Halo: `rings` circles growing by `step` px, each at `alpha`."
        },
        "rings": { "type": "integer", "format": "uint32", "minimum": 0, "x-unit": "count" },
        "step": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "xy" },
        "alpha": { "type": "number", "format": "double", "x-unit": "ratio" }
      },
      "required": ["x", "y", "r", "color", "glow", "rings", "step", "alpha"]
    },
    "Ridge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "amp": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "seed": { "type": "number", "format": "double", "x-unit": "none" },
        "color": { "$ref": "#/$defs/Color" }
      },
      "required": ["base", "amp", "seed", "color"],
      "description": "`y = base − amp × (0.5 + 0.3 sin(x × 0.006 + seed) + 0.2 sin(x × 0.017 + 3 seed))`, filled down to the bottom."
    },
    "Starfield": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer", "format": "uint32", "minimum": 0, "x-unit": "count" },
        "x": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "y": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "w": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "x" },
        "h": { "type": "number", "format": "double", "x-unit": "px", "x-axis": "y" },
        "size": {
          "type": "array",
          "items": { "type": "number", "format": "double" },
          "minItems": 2,
          "maxItems": 2,
          "x-unit": "px",
          "x-axis": "xy"
        },
        "color": { "$ref": "#/$defs/Color" },
        "twinkle": {
          "type": "number",
          "format": "double",
          "description": "Twinkle speed (degrees per tick).",
          "x-unit": "deg"
        }
      },
      "required": ["n", "x", "y", "w", "h", "size", "color", "twinkle"],
      "description": "Twinkling stars scattered (fixed pseudo-random layout) over the rectangle `x, y, w, h`."
    }
  }
}
